{
  "expo": {
    "name": "Simple Go Schedule",
    "slug": "mygotrainschedule",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mygotrainschedule",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.capricatech.simplegoschedule",
      "buildNumber": "5",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F0E1",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.capricatech.simplegoschedule"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#F5F0E1",
          "dark": {
            "backgroundColor": "#1A1A1A",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "reactCompiler": false
    },
    "extra": {
      "apiUrl": "https://simple-go-schedule-api-759545657799.northamerica-northeast2.run.app",
      "eas": {
        "projectId": "641563f8-e01b-4599-b332-4b8b74442a55"
      }
    }
  }
}
