# Required: Metrolinx OpenData API key
METROLINX_API_KEY=your_metrolinx_api_key_here

# Optional: Server port (Cloud Run injects PORT=8080 automatically; local dev defaults to 5000)
PORT=5000

# Optional: Comma-separated browser CORS origins (native iOS/Android apps do not need this)
# ALLOWED_ORIGINS=https://your-web-domain.com

# Optional: Public URL of this server (used for Stripe redirects if donations are enabled)
# PUBLIC_URL=https://simple-go-schedule-api-xxxxx.run.app

# Optional: Re-enable Stripe donations later by setting both keys
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...

# Client (Expo / EAS Build)
# EXPO_PUBLIC_API_URL=https://simple-go-schedule-api-xxxxx.run.app
# EXPO_PUBLIC_DONATIONS_ENABLED=false
